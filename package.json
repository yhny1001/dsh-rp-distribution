{
  "name": "@dsh-rp/workspace",
  "version": "0.1.0-rc.5",
  "description": "Independent RP plugin family for DeepSeek Harness",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "clean": "tsx scripts/clean.ts",
    "host:sdk": "tsx scripts/fetch-host-sdk.ts",
    "build:types": "pnpm run host:sdk && tsc -b packages/rp/*",
    "build:runtime": "tsdown",
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:runtime",
    "typecheck": "pnpm run host:sdk && tsc -b packages/rp/* --pretty false",
    "test": "pnpm run host:sdk && vitest run",
    "lint": "oxlint packages/rp scripts tests",
    "publint": "tsx scripts/publint.ts",
    "check:workspace": "tsx scripts/check-workspace.ts",
    "check": "pnpm run check:workspace && pnpm run lint && pnpm run test && pnpm run build && pnpm run publint",
    "release:rp": "tsx scripts/release/bump.ts --family rp",
    "release:verify": "tsx scripts/release/verify.ts --family rp",
    "release:pack": "tsx scripts/release/pack.ts --family rp",
    "release:evidence": "tsx scripts/release/evidence.ts --family rp",
    "release:verify-packed-install": "tsx scripts/release/verify-packed-install.ts --family rp",
    "release:publish": "tsx scripts/release/publish.ts --family rp"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/cosmokit": "1.8.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "execa": "^10.0.0",
    "jsdom": "30.0.1",
    "oxlint": "1.76.0",
    "publint": "^0.3.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "unrun": "^0.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
