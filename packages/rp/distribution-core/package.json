{
  "name": "@dsh-rp/distribution-core",
  "description": "Presentation-neutral DSH bundle for the standalone RP runtime",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhny1001/dsh-rp-distribution.git",
    "directory": "packages/rp/distribution-core"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@dsh-rp/agent-provider-harness": "workspace:^",
    "@dsh-rp/agent-runtime": "workspace:^",
    "@dsh-rp/branches": "workspace:^",
    "@dsh-rp/capability-catalog": "workspace:^",
    "@dsh-rp/character": "workspace:^",
    "@dsh-rp/compat-sillytavern": "workspace:^",
    "@dsh-rp/compat-stscript": "workspace:^",
    "@dsh-rp/component-runtime": "workspace:^",
    "@dsh-rp/experience-registry": "workspace:^",
    "@dsh-rp/first-party": "workspace:^",
    "@dsh-rp/harness-bridge": "workspace:^",
    "@dsh-rp/journal": "workspace:^",
    "@dsh-rp/library": "workspace:^",
    "@dsh-rp/lifecycle-l0": "workspace:^",
    "@dsh-rp/lifecycle-l1": "workspace:^",
    "@dsh-rp/lifecycle-l2": "workspace:^",
    "@dsh-rp/lore": "workspace:^",
    "@dsh-rp/media": "workspace:^",
    "@dsh-rp/media-input-attachment": "workspace:^",
    "@dsh-rp/memory-basic": "workspace:^",
    "@dsh-rp/memory-durable": "workspace:^",
    "@dsh-rp/memory-vector": "workspace:^",
    "@dsh-rp/outbox": "workspace:^",
    "@dsh-rp/persona": "workspace:^",
    "@dsh-rp/pipeline-runtime": "workspace:^",
    "@dsh-rp/policy": "workspace:^",
    "@dsh-rp/preset": "workspace:^",
    "@dsh-rp/projection": "workspace:^",
    "@dsh-rp/prompt": "workspace:^",
    "@dsh-rp/registry": "workspace:^",
    "@dsh-rp/registry-artifacts-local": "workspace:^",
    "@dsh-rp/registry-durable": "workspace:^",
    "@dsh-rp/registry-sources": "workspace:^",
    "@dsh-rp/relationship": "workspace:^",
    "@dsh-rp/rules": "workspace:^",
    "@dsh-rp/scene": "workspace:^",
    "@dsh-rp/sidecar-jobs": "workspace:^",
    "@dsh-rp/state": "workspace:^",
    "@dsh-rp/tool-capability": "workspace:^",
    "@dsh-rp/turn-runtime": "workspace:^",
    "@dsh-rp/workflow-backends-local": "workspace:^",
    "@dsh-rp/workflow-backends-sandbox": "workspace:^",
    "@dsh-rp/workflow-router": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.0.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  }
}
