{
  "name": "@dsh-rp/web",
  "description": "Playable DSH Web RP conversations, Studio, Creator, catalog API, and pipeline inspector",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhny1001/dsh-rp-distribution.git",
    "directory": "packages/rp/web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-modules": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-attachment": "0.0.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.0.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.0.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.0.1-rc.1",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@dsh-rp/capability-catalog": "workspace:^",
    "@dsh-rp/compat-sillytavern": "workspace:^",
    "@dsh-rp/component-runtime": "workspace:^",
    "@dsh-rp/contracts": "workspace:^",
    "@dsh-rp/experience-registry": "workspace:^",
    "@dsh-rp/library": "workspace:^",
    "@dsh-rp/media": "workspace:^",
    "@dsh-rp/memory-basic": "workspace:^",
    "@dsh-rp/outbox": "workspace:^",
    "@dsh-rp/pipeline-runtime": "workspace:^",
    "@dsh-rp/policy": "workspace:^",
    "@dsh-rp/preset": "workspace:^",
    "@dsh-rp/projection": "workspace:^",
    "@dsh-rp/registry": "workspace:^",
    "@dsh-rp/rules": "workspace:^",
    "@dsh-rp/turn-runtime": "workspace:^",
    "@dsh-rp/ui-slot-runtime": "workspace:^",
    "@dsh-rp/workflow-router": "workspace:^",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@dsh-rp/capability-catalog": "workspace:^",
    "@dsh-rp/compat-sillytavern": "workspace:^",
    "@dsh-rp/component-runtime": "workspace:^",
    "@dsh-rp/contracts": "workspace:^",
    "@dsh-rp/experience-registry": "workspace:^",
    "@dsh-rp/library": "workspace:^",
    "@dsh-rp/media": "workspace:^",
    "@dsh-rp/media-input-attachment": "workspace:^",
    "@dsh-rp/memory-basic": "workspace:^",
    "@dsh-rp/outbox": "workspace:^",
    "@dsh-rp/pipeline-runtime": "workspace:^",
    "@dsh-rp/policy": "workspace:^",
    "@dsh-rp/preset": "workspace:^",
    "@dsh-rp/projection": "workspace:^",
    "@dsh-rp/registry": "workspace:^",
    "@dsh-rp/rules": "workspace:^",
    "@dsh-rp/turn-runtime": "workspace:^",
    "@dsh-rp/ui-slot-runtime": "workspace:^",
    "@dsh-rp/workflow-router": "workspace:^",
    "@types/react": "~19.2.18",
    "react": "^19.2.8"
  }
}
