{
  "name": "@dsh-rp/registry-server",
  "description": "Self-hosted MIT reference Registry server for immutable RP package releases",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhny1001/dsh-rp-distribution.git",
    "directory": "packages/rp/registry-server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-rp-registry": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./bin": {
      "types": "./lib/types/bin.d.ts",
      "default": "./lib/bin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/bin.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-atomic-write": "0.0.1-rc.1",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.1",
    "@dsh-rp/contracts": "workspace:^",
    "@dsh-rp/package-runtime": "workspace:^",
    "@dsh-rp/sdk": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@dsh-rp/contracts": "workspace:^",
    "@dsh-rp/package-runtime": "workspace:^",
    "@dsh-rp/registry-sources": "workspace:^",
    "@dsh-rp/sdk": "workspace:^"
  }
}
